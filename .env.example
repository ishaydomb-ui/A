# Copy to .env (and load it, e.g. with `export $(cat .env | xargs)` or a
# process manager's env file support) — never commit the real .env.

# Required: token from @BotFather for the dedicated groceries bot.
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated Telegram numeric user IDs allowed to trigger
# orders / add ad-hoc items (yours and Liran's). Leave empty while testing
# solo; set it before exposing the bot beyond just you.
ALLOWED_TELEGRAM_USER_IDS=

# Where the SQLite database lives.
GROCERY_BOT_DB_PATH=data/grocery_bot.sqlite3

# Comma-separated list of stores to run each cycle against. Only
# "shufersal" has an adapter implemented so far (Phase 1); "tiv_taam" is
# Phase 2.
ENABLED_STORES=shufersal

# Paths to the storage_state.json files produced by scripts/login_helper.py.
SHUFERSAL_STORAGE_STATE_PATH=data/sessions/shufersal_storage_state.json
TIVTAAM_STORAGE_STATE_PATH=data/sessions/tivtaam_storage_state.json

# Set to "false" to watch the browser while debugging locally.
PLAYWRIGHT_HEADLESS=true

# SOCKS5 proxy for the store sites, which block non-Israeli IPs.
# Empty = no proxy (only works if this machine is already in Israel).
PLAYWRIGHT_PROXY=socks5://localhost:1055

# Optional: lets the bot re-create an expired session on its own instead of
# asking you to log in again. Without these it still runs, but a dead
# session needs a manual scripts/headless_login.py or login_helper.py run.
#
# As of 2026-09-18 these are the FALLBACK, not the primary channel: if the
# household's shared Bitwarden vault is reachable (BW_CLIENTID/
# BW_CLIENTSECRET/BW_PASSWORD set, e.g. via ~/.config/familyos/secrets.env
# as an EnvironmentFile), grocery_bot/bitwarden.py is tried first for a
# vault item matching the Shufersal login URL, and these vars are only
# used when that lookup is unavailable or comes back empty. See
# grocery_bot/config.py::_shufersal_credentials.
SHUFERSAL_USERNAME=
SHUFERSAL_PASSWORD=

# Tiv Taam account, same handling as Shufersal: used only to read the
# catalogue, history and club/discount terms, and to fill a cart.
# Never for payment or account settings (see CLAUDE.md).
TIVTAAM_USERNAME=
TIVTAAM_PASSWORD=

# Used to build the "more deals" deep link in the nudge message.
TELEGRAM_BOT_USERNAME=
