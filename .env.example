# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit a filled-in .env.
# Generate secrets with:  openssl rand -base64 48
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Postgres. In Docker Compose the host is the `db` service name.
POSTGRES_USER=medapp
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_DB=medcat
DATABASE_URL=postgres://medapp:change-me-before-deploying@db:5432/medcat
DATABASE_SSL=false
DB_POOL_MAX=10

# Master secret used to derive token-hashing and MFA-encryption keys.
# Must be >= 32 chars and must not contain "change-me" in production.
APP_SECRET=change-me-generate-a-real-48-byte-secret-before-use

# Public origin of the web app; used for links in invitation/reset emails.
PUBLIC_URL=https://catalogue.example.org
COOKIE_SECURE=true
# COOKIE_DOMAIN=catalogue.example.org

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
INVITE_EXPIRY_HOURS=72
RESET_EXPIRY_MINUTES=60
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

IMPORT_STORAGE_DIR=/data/imports
MAX_UPLOAD_BYTES=26214400

# Outbound mail. If SMTP_URL is unset, messages are written to the log and to
# an on-disk outbox instead of being sent, so nothing is silently lost.
# SMTP_URL=smtps://user:password@smtp.example.org:465
MAIL_FROM=no-reply@catalogue.example.org

LOG_LEVEL=info
TRUST_PROXY=true

# Hostname Caddy should obtain a certificate for.
SITE_HOSTNAME=catalogue.example.org
ACME_EMAIL=ops@example.org

# Backups (see ops/backup.sh). The passphrase encrypts every dump.
BACKUP_PASSPHRASE=change-me-generate-a-real-passphrase
BACKUP_RETENTION_DAYS=30
