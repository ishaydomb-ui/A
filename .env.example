# ---- Core ----
# The agent brain. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Model used for the household agent.
AGENT_MODEL=claude-sonnet-5

# Where the SQLite file lives. Use a mounted volume in production.
DATABASE_PATH=./data/beitenu.sqlite

# 32-byte hex key used to encrypt stored store credentials (openssl rand -hex 32)
CREDENTIALS_KEY=

# ---- Google (Calendar / Gmail / Drive) ----
# Create an OAuth app at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---- Intake channels ----
# Shared secret that inbound webhooks (WhatsApp/Telegram/Shortcuts) must present.
INTAKE_TOKEN=
# WhatsApp Cloud API (optional)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Outbound email digests (optional) ----
SMTP_URL=
DIGEST_TO=ishaydomb@gmail.com,lirikor@gmail.com

# ---- Grocery ----
# Chain to use for basket automation: shufersal | tivtaam
GROCERY_DEFAULT_CHAIN=shufersal
# Set to "1" to allow the browser worker to run. Checkout is NEVER automated.
BROWSER_WORKER_ENABLED=0
