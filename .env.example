# ---- Core ----
# The agent brain. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Model used for the household agent.
AGENT_MODEL=claude-sonnet-5

# Where the SQLite file lives. In production this must sit on a mounted volume
# (Railway: /data) or every redeploy wipes the household.
DATABASE_PATH=./data/beitenu.sqlite

# Run automations (morning brief, calendar sync, coupon sweep) inside the web
# process. Leave off locally; set to 1 on a deployed instance.
ENABLE_SCHEDULER=0
SCHEDULER_INTERVAL_MINUTES=15

# 32-byte hex key used to encrypt stored store credentials (openssl rand -hex 32)
CREDENTIALS_KEY=

# Signs the session cookie. Any random string of 32+ chars (openssl rand -hex 32).
# Changing it signs everyone out.
AUTH_SECRET=

# ---- Google (sign-in + Calendar / Gmail / Drive) ----
# Create an OAuth app at https://console.cloud.google.com/
#   1. APIs & Services > Credentials > Create OAuth client ID > Web application
#   2. Add the redirect URI below to "Authorised redirect URIs"
#   3. Enable the Google Calendar API for the project
# NOTE: while GOOGLE_CLIENT_ID is unset the app runs WITHOUT sign-in and
# attributes everything to Ishay. A deployed instance must set it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---- Intake channels ----
# Shared secret that inbound webhooks (WhatsApp/Telegram/Shortcuts) must present.
INTAKE_TOKEN=
# WhatsApp Cloud API (optional)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Outbound mail ----
# No SMTP setting exists, deliberately. Mail to Ishay and Liran goes out through
# their own Gmail via OAuth (gmail.send scope); mail to anyone else is not
# possible at all - it stops at a draft they send themselves.

# ---- Grocery ----
# Chain to use for basket automation: shufersal | tivtaam
GROCERY_DEFAULT_CHAIN=shufersal
# Set to "1" to allow the browser worker to run. Checkout is NEVER automated.
BROWSER_WORKER_ENABLED=0
