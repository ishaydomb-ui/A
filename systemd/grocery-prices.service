[Unit]
Description=Refresh Shufersal price/promotion catalog from the public feed
Documentation=file:/home/codex/grocery-automation/README.md
After=network-online.target
Wants=network-online.target
# A failed unit otherwise sits red with nobody looking — this box is
# administered from a phone, and systemd reports only when asked.
OnFailure=grocery-alert@%N.service

[Service]
Type=oneshot
WorkingDirectory=%h/grocery-automation
EnvironmentFile=%h/grocery-automation/.env
Environment=TZ=Asia/Jerusalem
ExecStart=%h/grocery-automation/.venv/bin/python -m grocery_bot.cli refresh-prices

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/grocery-automation/data
# Commented out, matching every other unit in this project: they need a
# user namespace to sandbox, and this kernel's
# apparmor_restrict_unprivileged_userns=1 blocks that for non-root user
# units, so systemd exits 218/CAPABILITIES before the service even
# starts. Missing this fix here (while the other four units got it) left
# grocery-prices.service dead since the last reboot with no price
# refresh running. See HANDOFF.md §"Since the last anchor", 2026-09-05.
# ProtectKernelTunables=true
# ProtectKernelModules=true
# ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=grocery-prices
