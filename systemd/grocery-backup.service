[Unit]
Description=Push grocery-automation commits to GitHub if any are pending
Documentation=file:/home/codex/grocery-automation/README.md
After=network-online.target
Wants=network-online.target
# A failed unit otherwise sits red with nobody looking — this box is
# administered from a phone, and systemd reports only when asked.
OnFailure=grocery-alert@%N.service

[Service]
Type=oneshot
WorkingDirectory=%h/grocery-automation
Environment=TZ=Asia/Jerusalem
# No GIT_SSH_COMMAND override needed: ssh already reads ~/.ssh/config by
# default, which is where the github-grocery host alias (deploy key) is
# defined.
ExecStart=%h/grocery-automation/scripts/auto_push.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Needs write access to the whole repo, not just data/: a push updates
# .git internals (refs, objects), not the application's own state.
ReadWritePaths=%h/grocery-automation
# Read-only is enough for the deploy key under ~/.ssh.
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=grocery-backup
