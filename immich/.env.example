# ==========================================================================
#  Immich – קובץ הגדרות. העתק ל-.env ("cp .env.example .env") וערוך.
#  התיעוד המלא של כל המשתנים:
#  https://docs.immich.app/install/environment-variables
# ==========================================================================

# היכן יישמרו התמונות והסרטונים שהועלו.
# >>> זה המשתנה שקובע את נפח האחסון – הצבע אותו על הדיסק/ה-NAS הגדול.
#     דוגמה: UPLOAD_LOCATION=/srv/immich/library
UPLOAD_LOCATION=./library

# היכן יישמרו קובצי מסד הנתונים (Postgres).
# חייב להיות דיסק מקומי (רצוי SSD) – שיתוף רשת/NFS/SMB לא נתמך ויגרום לנזק.
DB_DATA_LOCATION=./postgres

# אזור זמן – משפיע על תאריכי התיקיות בתבנית האחסון ועל לוחות הזמנים של המשימות.
TZ=Asia/Jerusalem

# גרסת Immich. "v3" = תמיד העדכון האחרון בסדרה 3.
# אפשר לנעול לגרסה מדויקת, למשל: IMMICH_VERSION=v3.1.0
IMMICH_VERSION=v3

# סיסמת מסד הנתונים. אותיות וספרות בלבד (A-Za-z0-9), ללא רווחים ותווים מיוחדים.
# הסקריפט install.sh מייצר כאן סיסמה אקראית אוטומטית.
DB_PASSWORD=CHANGE_ME

# --- אין צורך לשנות מכאן ומטה ---------------------------------------------
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
