__pycache__/
*.pyc
.venv/
venv/
.env
data/*.sqlite3
data/sessions/*.json
!data/sessions/.gitkeep
# Persistent browser profile holding a live store login (cookies + localStorage).
data/sessions/*_profile/
.remote_desktop/

# Personal data: the real base list stays local; the .example file is the template.
data/base_list.yaml

# Machine-local watchdog state. Committing it would churn on every
# timer run and conflict between hosts; it describes this box only.
data/backup_heartbeat.json
data/backup_doctor_state.json

# Benefits-harvest data (behatsdaa + other clubs). This is the household's
# private financial data — voucher and card-load history, personal
# catalogs — and this repo pushes to GitHub, so the entire directory is
# kept out of git. Nothing under here is ever committed. Card details are
# never brought here at all (a hard rule); this ignore is the second line
# of defence, not the first.
data/benefits/

# Coffeetrail harvest (public coffee-cart directory data). Not private —
# kept out of git purely because it's a large, regenerable external
# corpus: a monthly re-harvest would otherwise churn hundreds of lines on
# every push. Re-run scripts/harvest_coffeetrail.py to reproduce it.
data/coffeetrail/
